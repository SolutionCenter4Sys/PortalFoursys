# Copie para .env.local e preencha os valores
# cp .env.example .env.local

# INFERENCE_PROVIDER: local | openai | openai-llm | gemini | gemini-llm
# NOTA: com a migration 006 aplicada, provider e parâmetros ficam no banco
# (tabela llm_settings, editável em /admin/llm) e o .env vira só o DEFAULT/fallback.
INFERENCE_PROVIDER=local
# TTL (ms) do cache das settings dinâmicas — quanto tempo até refletir mudança do
# banco sem a UI (a UI invalida na hora ao salvar). Default 15000.
# LLM_SETTINGS_TTL_MS=15000

# Temperatura do LLM (0.0–1.0). Baixa = menos erro de sintaxe / mais fiel à
# instrução (bom p/ modelo pequeno). Default 0.3. No gateway: OLLAMA_TEMPERATURE no .env dele.
# OLLAMA_TEMPERATURE=0.3

# ---- Provider: local ---------------------------------------------------------
LOCAL_LLM_ENABLED=true
LOCAL_LLM_BASE_URL=http://SEU_SERVIDOR:11434/v1
LOCAL_LLM_MODEL=llama3.2:3b

WHISPER_BASE_URL=http://SEU_SERVIDOR:8000
WHISPER_MODEL=Systran/faster-whisper-small
PIPER_WYOMING_URL=tcp://SEU_SERVIDOR:10200
VOICE_GATEWAY_URL=http://localhost:8787

VOICE_DEV_MODE=false
# Permite /api/voice/* sem sessão (Portal /embed).
VOICE_EMBED_ANON=true
USAGE_LIMIT_DISABLED=true
# US-3.2 — streaming frase-a-frase (LLM->TTS) p/ começar a falar em ~1-2s.
# Só cloud full (openai/gemini). Desligado por padrão; =true para ativar.
# VOICE_STREAMING=true

# ---- Provider: openai / openai-llm -------------------------------------------
OPENAI_API_KEY=sk-proj-...
OPENAI_MODEL=gpt-4o-mini
# Teto de tokens da resposta (default 1024). Baixo demais corta a resposta no meio.
# OPENAI_MAX_TOKENS=1024
# OPENAI_TTS_VOICE=onyx
# VOICE_TTS_PREFER=openai
# OPENAI_TTS_MODEL=tts-1

# ---- Provider: gemini (STT+LLM+TTS Google) / gemini-llm (só LLM, áudio no browser) ----
# "gemini" e "gemini-full" são equivalentes (pipeline completo do Google).
GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-3.5-flash
# GEMINI_TEMPERATURE=0.3
# Teto total de tokens (thinking + resposta). Default 2048 p/ caber o raciocínio
# E a resposta completa (thinking do Gemini 2.5 conta aqui).
# GEMINI_MAX_TOKENS=2048
# Thinking do Gemini 2.5: 1024=ligado (default — respostas mais elaboradas),
# 0=desligado (mais rápido), -1=automático, N=orçamento fixo de raciocínio.
# GEMINI_THINKING_BUDGET=0
# Portal: força thinkingBudget=0 no Gemini só no surface=portal (respostas curtas
# ancoradas em FAQ+brief; thinking só atrasa TTFT em 300-800 ms).
# PORTAL_GEMINI_THINKING_BUDGET=0
# Portal: tamanho mínimo do bloco falado (chars). Global default 160 espera quase
# toda a geração antes do 1º áudio; 60 começa a falar após a 1ª frase.
# PORTAL_VOICE_MIN_FLUSH_CHARS=60
# Portal: se o texto falável parar de crescer por N ms, solta o bloco pendente.
# Global default 600. 300 corta a pausa de abertura da resposta.
# PORTAL_VOICE_STALL_FLUSH_MS=300
# Modelo usado no STT multimodal (default = GEMINI_MODEL)
# GEMINI_STT_MODEL=gemini-3.5-flash
# TTS: modelo preview + voz. Vozes masculinas: Charon, Orus, Fenrir, Puck.
# GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
# GEMINI_TTS_VOICE=Charon

# ---- Supabase ----------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Homol Azure: https://white-sea-0357d9b0f.7.azurestaticapps.net (sem barra final)
# NEXT_PUBLIC_SITE_URL=
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ---- RAG ---------------------------------------------------------------------
# Embeddings seguem a LLM ativa (Admin -> LLM / llm_settings). Override:
# RAG_EMBED_PROVIDER=auto|gemini|openai|ollama
# RAG_EMBED_FALLBACK=true   # se o backend primário falhar, tenta os outros
# GEMINI_EMBED_MODEL=gemini-embedding-001
# OPENAI_EMBED_MODEL=text-embedding-3-small
OLLAMA_EMBED_MODEL=nomic-embed-text
# OLLAMA_EMBED_DIMS=768   # deve bater com pgvector (migration 003)
RAG_ENABLED=true
# Modo ancorado: o LLM responde SÓ com contexto fixo + fatos Foursys + fontes RAG
# (sem internet / sem conhecimento geral). Default ligado; =false para liberar.
LLM_RAG_ONLY=true
RAG_PORTAL_REPO=owner/repo
# GITHUB_TOKEN=
# RAG_AGENTS_ROOT=C:\caminho\para\agentes

# ---- Voz — captura (client-side, precisam do prefixo NEXT_PUBLIC) ------------
# Frases de ativação (wake words), separadas por vírgula. SUBSTITUI o padrão
# (olá jarvis / ok jarvis / ei jarvis / hey jarvis / jarvis). A 1ª aparece no
# hint da UI. Remova "jarvis" solto daqui se ele disparar sozinho demais.
# NEXT_PUBLIC_WAKE_ALIASES=jarvis,ok jarvis,ei jarvis
# Silêncio (ms) tolerado antes de considerar a fala encerrada (200–3000).
# Aumente se o Jarvis te cortar em pausas naturais; padrão 800.
# NEXT_PUBLIC_VAD_REDEMPTION_MS=800

# ---- Redis (TokenOps cache + sessão quente) ----------------------------------
REDIS_URL=redis://:SENHA@SEU_SERVIDOR:6379
# Desliga o Redis explicitamente (cache/sessão viram no-op, sem erro). Deixe a
# app rodar sem Redis. Se omitido, o Redis é usado quando REDIS_URL existir.
# REDIS_ENABLED=false
# Se o Redis cair, um circuit breaker o pula por este período antes de tentar de
# novo — evita pagar timeout de conexão a cada turno (default 60000ms).
# REDIS_BREAKER_COOLDOWN_MS=60000
REDIS_CACHE_TTL_SECONDS=86400
# Cache semântico: cosine mínimo p/ reusar resposta (0.90 = repetições quase-idênticas)
REDIS_SEMANTIC_THRESHOLD=0.90
# Máx. de entradas varridas por lookup no cache semântico (default 500)
# REDIS_SEMANTIC_MAX_ENTRIES=500

# ---- RAG ingest --------------------------------------------------------------
# Concorrência do fetch de arquivos GitHub na indexação (default 6)
# GITHUB_FETCH_CONCURRENCY=6

# ---- RAG contexto (otimizado p/ LLM pequeno — menos ruído, menor latência) ---
# Nº de trechos injetados no prompt (default 3) e tamanho máx. por trecho (default 700)
# RAG_CONTEXT_MAX_CHUNKS=3
# RAG_CONTEXT_MAX_CHARS=700

# ---- Pipecat streaming (E3 Fase B) -------------------------------------------
VOICE_STREAM_URL=ws://SEU_SERVIDOR:8788

# Limite de chars p/ TTS Piper em CPU (evita timeout em respostas longas)
# TTS_MAX_CHARS=500

# ---- ADR-015 Local Agent Bridge (só loopback — nunca expor na Vercel) --------
# Correr: cd agent-bridge && $env:AGENT_BRIDGE_TOKEN="dev-local-token"; npm start
# AGENT_BRIDGE_URL=http://127.0.0.1:8787
# AGENT_BRIDGE_TOKEN=dev-local-token
# Workspace default (alias em agent-bridge/workspaces.json): web | jarvis | portal
# AGENT_WORKSPACE=web
# AGENT_ALLOWLIST=C:\Users\...\Documents\AI-DLC\Jarvis   # no processo do bridge (legado)
