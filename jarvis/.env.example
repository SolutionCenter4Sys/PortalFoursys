# ══════════════════════════════════════════════════════════════════════════════
# INFERENCE_PROVIDER — troque esta linha para alternar entre os providers
# ══════════════════════════════════════════════════════════════════════════════
#
#   local       → Ollama (Llama 3.2) + Whisper + Piper   (requer servidor remoto)
#   openai      → OpenAI completo: Whisper API + GPT-4o-mini + TTS-1 (requer créditos de áudio)
#   openai-llm  → OpenAI só LLM (GPT-4o-mini) + STT/TTS no browser (sem créditos de áudio)
#   gemini (STT+LLM+TTS Google) / gemini-llm (só LLM, áudio no browser) ─
#  "gemini" e "gemini-full" são equivalentes (pipeline completo do Google).

INFERENCE_PROVIDER=gemini
# Tabela llm_settings vazia → governança 100% pelo .env. true = pula a consulta
# Supabase a cada 15s no getLlmSettings (poupa ~150-300ms de RPC ca-central-1).
# Reative removendo esta linha se voltar a usar a UI /admin/llm.
LLM_SETTINGS_ENV_ONLY=true
# Backend de embeddings explícito (evita cair em Ollama por engano se llm_settings
# tiver algo estranho). gemini = embedding-001 cloud. Se trocar, reindexar RAG.
RAG_EMBED_PROVIDER=gemini

# ── Provider: local ───────────────────────────────────────────────────────────
LOCAL_LLM_ENABLED=true
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=qwen2.5:7b

WHISPER_BASE_URL=http://localhost:8000
WHISPER_MODEL=Systran/faster-whisper-small
PIPER_WYOMING_URL=tcp://localhost:10200

# Python Inference Gateway (ADR-013) — liga STT+LLM+TTS em um único endpoint
VOICE_GATEWAY_URL=http://localhost:8787

VOICE_DEV_MODE=false
USAGE_LIMIT_DISABLED=true   # remover em produção

# ── Provider: openai / openai-llm ─────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# gpt-4o-mini-tts (mais novo) tem dicção multilíngue significativamente melhor
# em pt-BR vs tts-1/tts-1-hd. Vozes masc: ash (moderna, quente), verse (dramática),
# sage (neutra/calma), alloy (neutra leve). Fem: coral, nova, shimmer. Latência similar ao tts-1.
OPENAI_TTS_VOICE=verse
OPENAI_TTS_MODEL=gpt-4o-mini-tts
# Velocidade de fala (OpenAI TTS). 1.0 = default. Faixa recomendada 1.05–1.25
# para voice UX ágil sem soar corrido. Sobe/desce em 0.05.
OPENAI_TTS_SPEED=1.20
# gpt-4o-mini-tts SÓ: instrução em linguagem natural sobre estilo/ritmo/tom.
# Ignorado nos modelos tts-1/tts-1-hd. Deixe vazio para default do modelo.
OPENAI_TTS_INSTRUCTIONS=Fale em português brasileiro com ritmo natural mas ágil, tom profissional e acolhedor de anfitrião apresentando a Foursys. Dicção clara e articulada, sem lentidão nem robotização. Enfatize levemente nomes próprios (Foursys, DataForge, QA).
OPENAI_MAX_TOKENS=1024

# ── Provider: gemini (STT+LLM+TTS Google) / gemini-llm (só LLM, áudio no browser) ─
# "gemini" e "gemini-full" são equivalentes (pipeline completo do Google).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TEMPERATURE=0.3
# Modelo usado no STT multimodal (default = GEMINI_MODEL)
GEMINI_STT_MODEL=gemini-3.5-flash
# TTS: modelo preview + voz. Vozes masculinas: Charon, Orus, Fenrir, Puck.
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
GEMINI_TTS_VOICE=Charon
GEMINI_THINKING_BUDGET=0
GEMINI_MAX_TOKENS=1024
# TTS rápido: OpenAI primeiro (Gemini TTS ~8s). gemini = voz Charon.
VOICE_TTS_PREFER=gemini
# Portal embed: OpenAI TTS (~1-2s). gemini = Charon lento (~8-20s).
VOICE_PORTAL_TTS_PREFER=openai

# ── TTS performance (a: streaming · b: cache) ─────────────────────────────────
# Cache de áudio TTS em Redis p/ frases fixas (saudação + FAQ) e recorrentes no
# Portal → hit = instantâneo (0ms de síntese). Invalida ao trocar voz/modelo.
TTS_CACHE_ENABLED=true
TTS_CACHE_TTL_SECONDS=2592000   # 30 dias
# Streaming do Gemini TTS (generateContentStream): melhor time-to-first-chunk e
# menos timeouts. true = liga. (Reprodução ainda é do blob completo.)
GEMINI_TTS_STREAM=false
# Portal STT: Whisper (OpenAI) é ~2-3x mais rápido que Gemini multimodal.
# Portal usa OpenAI STT por padrão. gemini = força Gemini STT no Portal.
PORTAL_STT_PREFER=openai
# Modelo STT OpenAI. gpt-4o-mini-transcribe = mais rápido/preciso (PT-BR) que whisper-1.
# Reverter: OPENAI_STT_MODEL=whisper-1
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
# Timeouts OpenAI (ms). SDK default é 10min + 2 retries → um engasgo de rede
# pendura o turno por minutos. Aqui falha rápido e cai no fallback Gemini.
OPENAI_TIMEOUT_MS=20000
OPENAI_MAX_RETRIES=1
OPENAI_STT_TIMEOUT_MS=12000
OPENAI_TTS_TIMEOUT_MS=12000
# Portal: teto de tokens da resposta falada. Menor = LLM termina antes e gera
# menos blocos de TTS (corta cauda de síntese). 300 ≈ 4-5 frases curtas.
PORTAL_MAX_TOKENS=300
# Portal: reasoning (thinking) do Gemini queima tokens ANTES do 1º token visível.
# 0 = desligado (−300 a −800 ms de TTFT). Respostas do Portal são curtas ancoradas
# em FAQ+brief; reasoning só atrasa. Sobe se a qualidade regredir.
PORTAL_GEMINI_THINKING_BUDGET=0
# Portal: tamanho mínimo do bloco falado. Default global é 160 chars → em respostas
# curtas o TTFA espera quase toda a geração. 60 = começa a falar após a 1ª frase.
PORTAL_VOICE_MIN_FLUSH_CHARS=60
# Portal: se o texto falável estagnar por N ms, solta o bloco pendente. Default
# global é 600. 300 = corta pausa perceptível na abertura da resposta.
PORTAL_VOICE_STALL_FLUSH_MS=300
# Nº de sínteses TTS em paralelo (por turn). Default no código = 4. 8 drena a
# fila mais rápido em respostas longas (reduz ttsTail) sem risco de rate-limit
# na OpenAI TTS. Baixe se aparecer erro 429 no log da OpenAI.
VOICE_TTS_CONCURRENCY=8
# Half-duplex: cooldown (ms) antes de religar o mic pós-fala do Jarvis. Maior =
# menos auto-eco (mic não capta a própria cauda/reverberação) porém conversa
# menos ágil. Embed default 350. Se ainda captar eco, sobe p/ 500-700.
NEXT_PUBLIC_VOICE_MIC_REARM_MS=350
# ── Ambiente RUIDOSO (feira/stand) — endurecer VAD p/ não disparar em ruído ──
# Sobe o limiar de "isto é fala" (0.5→0.7/0.8) e exige fala mais longa. Descomente:
NEXT_PUBLIC_VAD_POSITIVE_THRESHOLD=0.7
NEXT_PUBLIC_VAD_MIN_SPEECH_MS=250
NEXT_PUBLIC_VOICE_MIN_UTTERANCE_MS=600

# Token dev p/ reindexar via Postman/curl sem cookie (header x-admin-token).
# Deixe VAZIO em produção para desabilitar o bypass.
RAG_ADMIN_TOKEN=

# ── RAG v2 — chunking enxuto (menos/menor chunk = prompt menor = TTFT menor) ──
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150
# Lean: exclui código de app (.ts/.tsx fora de src/data e src/i18n). false = indexa tudo.
RAG_LEAN_INDEX=true

# ── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role (RAG ingest — nunca expor ao browser).
SUPABASE_SERVICE_ROLE_KEY=

# Ollama embeddings (local, sem API key)
# OLLAMA_BASE_URL derivado automaticamente de LOCAL_LLM_BASE_URL — só sobrescrever se diferente
# OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
# OLLAMA_EMBED_DIMS=768   # nomic-embed-text=768 | mxbai-embed-large=1024 | bge-m3=1024
# Para melhor suporte PT-BR: ollama pull bge-m3  (mudar DIMS para 1024 + rodar migration 003 novamente)

RAG_ENABLED=true
RAG_PORTAL_REPO=owner/repo
GITHUB_TOKEN=

# Agentes Foursys Solution Center — 52 personas indexadas como 3ª fonte RAG
RAG_AGENTS_ROOT=C:\caminho\para\agentes

# ── Redis (TokenOps cache + sessão quente) ─────────────────────────────────────
REDIS_ENABLED=true
REDIS_URL=redis://:SENHA@localhost:6379
REDIS_CACHE_TTL_SECONDS=86400
# Cache semântico: similaridade cosine mínima p/ reusar resposta (nomic-embed-text)
REDIS_SEMANTIC_THRESHOLD=0.90

# ── Pipecat streaming (E3 Fase B) ─────────────────────────────────────────────
VOICE_STREAM_URL=ws://localhost:8788

# Silêncio antes de encerrar fala (ms). Aumente se cortar no meio (200–3000).
# Também ajustável em Configurações → Voz (localStorage).
NEXT_PUBLIC_VAD_REDEMPTION_MS=1600

AGENT_BRIDGE_URL=http://127.0.0.1:8787
AGENT_BRIDGE_TOKEN=dev-local-token
# Alias default (workspaces.json): web | jarvis | portal
AGENT_WORKSPACE=web
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Portal embed — voz sem login
VOICE_EMBED_ANON=true

# Portal FAQ lexical (sem Redis). Seed Redis opcional: npm run seed:portal-faq
# Threshold do FAQ instantâneo (0-1). Mais alto = menos respostas canned, mais
# raciocínio do LLM. Default 0.6. Baixe p/ 0.42 se quiser mais hits instantâneos.
# PORTAL_FAQ_MIN_SCORE=0.6
