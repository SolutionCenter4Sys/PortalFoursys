# â�?��?�â�?��?� Provider: gemini (STT+LLM+TTS Google) / gemini-llm (s�?³ LLM, �?¡udio no browser) â�?��?�
# "gemini" e "gemini-full" s�?£o equivalentes (pipeline completo do Google).
GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-3.5-flash
# GEMINI_TEMPERATURE=0.3
# Teto TOTAL de tokens (thinking + resposta). Default 2048 p/ caber o racioc�?­nio
# E a resposta completa (thinking do Gemini 2.5 conta aqui).
# GEMINI_MAX_TOKENS=2048
# Thinking do Gemini 2.5: 1024=ligado (default â�?��?� respostas mais elaboradas),
# 0=desligado (mais r�?¡pido), -1=autom�?¡tico, N=or�?§amento fixo de racioc�?­nio.
# GEMINI_THINKING_BUDGET=0
# Portal: forca thinkingBudget=0 no Gemini so no surface=portal (respostas curtas
# ancoradas em FAQ+brief; thinking so atrasa TTFT em 300-800 ms).
# PORTAL_GEMINI_THINKING_BUDGET=0
# Portal: tamanho minimo do bloco falado (chars). Global default 160 espera quase
# toda a geracao antes do 1o audio; 60 comeca a falar apos a 1a frase.
# PORTAL_VOICE_MIN_FLUSH_CHARS=60
# Portal: se o texto falavel parar de crescer por N ms, solta o bloco pendente.
# Global default 600. 300 corta a pausa de abertura da resposta.
# PORTAL_VOICE_STALL_FLUSH_MS=300
# Modelo usado no STT multimodal (default = GEMINI_MODEL)
# GEMINI_STT_MODEL=gemini-3.5-flash
# TTS: modelo preview + voz. Vozes masculinas: Charon, Orus, Fenrir, Puck.
# GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
# GEMINI_TTS_VOICE=Charon

