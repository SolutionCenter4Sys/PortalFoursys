# ── .env.docker.example ───────────────────────────────────────────────────────
# Copie para .env.docker e preencha os valores ANTES de rodar docker compose.
#   cp .env.docker.example .env.docker
#
# Este arquivo é lido pelo serviço "jarvis" no docker-compose.yml.
# NUNCA commite .env.docker — ele já está no .gitignore raiz.

# ── PostgreSQL local (pgvector) ───────────────────────────────────────────────
# Credenciais do container postgres. DATABASE_URL é montado automaticamente
# pelo docker-compose — você só precisa alterar se quiser valores diferentes.
POSTGRES_DB=jarvis
POSTGRES_USER=jarvis
POSTGRES_PASSWORD=troque-por-senha-segura
# DATABASE_URL é sobrescrito pelo docker-compose. Preencha se rodar o Jarvis
# fora do compose apontando para o postgres local:
# DATABASE_URL=postgresql://jarvis:troque-por-senha-segura@localhost:5432/jarvis

# Para continuar usando Supabase cloud em vez do postgres local, deixe
# DATABASE_URL vazia e preencha as vars NEXT_PUBLIC_SUPABASE_* abaixo.

# ── Redis ─────────────────────────────────────────────────────────────────────
# Senha do Redis interno. Deve bater com REDIS_URL abaixo.
REDIS_PASSWORD=troque-por-senha-segura
# REDIS_URL é sobrescrito automaticamente pelo docker-compose para apontar ao
# container interno — você só precisa disso se rodar o Jarvis fora do compose.
# REDIS_URL=redis://:troque-por-senha-segura@redis:6379
REDIS_CACHE_TTL_SECONDS=86400
REDIS_SEMANTIC_THRESHOLD=0.90

# ── Inference provider ─────────────────────────────────────────────────────────
# gemini | openai | openai-llm | gemini-llm
INFERENCE_PROVIDER=gemini

# ── Gemini ────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-2.5-flash
PORTAL_GEMINI_THINKING_BUDGET=0

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-proj-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=verse
OPENAI_TTS_SPEED=1.20
OPENAI_TTS_INSTRUCTIONS=Fale em português brasileiro com ritmo natural mas ágil. Voz masculina, tom consultivo e confiante, sem exageros dramáticos.

# ── Supabase (opcional — só se NÃO usar postgres local) ──────────────────────
# Com DATABASE_URL configurada acima, estas variáveis são ignoradas para RAG.
# Deixe em branco para rodar 100% local sem dependência de cloud.
# NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJETO.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Voice / Portal ─────────────────────────────────────────────────────────────
VOICE_EMBED_ANON=true
USAGE_LIMIT_DISABLED=true
LLM_SETTINGS_ENV_ONLY=true
LLM_RAG_ONLY=true
PORTAL_VOICE_MIN_FLUSH_CHARS=60
PORTAL_VOICE_STALL_FLUSH_MS=300
VOICE_TTS_CONCURRENCY=8

# ── RAG ───────────────────────────────────────────────────────────────────────
RAG_ENABLED=true
RAG_EMBED_PROVIDER=gemini
RAG_PORTAL_REPO=SolutionCenter4Sys/PortalFoursys
# GITHUB_TOKEN=ghp_... (necessário se o repo for privado)
