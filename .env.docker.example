# ── .env.docker.example ───────────────────────────────────────────────────────
# Copie para .env.docker e preencha as keys ANTES de docker compose.
#   cp .env.docker.example .env.docker
#
# Lido pelo serviço "jarvis" (runtime) e pelos scripts npm docker:* (--env-file).
# NUNCA commite .env.docker.
#
# Conjunto alinhado ao .env.local ativo. Sem secrets.
# REDIS_URL e DATABASE_URL são sobrescritos pelo docker-compose (containers internos).

# ── PostgreSQL local (pgvector no compose) ────────────────────────────────────
POSTGRES_DB=jarvis
POSTGRES_USER=jarvis
POSTGRES_PASSWORD=troque-por-senha-segura

# ── Redis (container interno) ─────────────────────────────────────────────────
REDIS_PASSWORD=troque-por-senha-segura
REDIS_ENABLED=true
REDIS_CACHE_TTL_SECONDS=86400
REDIS_SEMANTIC_THRESHOLD=0.90
TTS_CACHE_ENABLED=true
TTS_CACHE_TTL_SECONDS=2592000

# ══════════════════════════════════════════════════════════════════════════════
INFERENCE_PROVIDER=gemini
LLM_SETTINGS_ENV_ONLY=true
RAG_EMBED_PROVIDER=gemini

# ── Provider: openai ──────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_TTS_VOICE=verse
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_SPEED=1.20
OPENAI_TTS_INSTRUCTIONS=Fale em português brasileiro com ritmo natural mas ágil, tom profissional e acolhedor de anfitrião apresentando a Foursys. Dicção clara e articulada, sem lentidão nem robotização. Enfatize levemente nomes próprios (Foursys, DataForge, QA).
OPENAI_MAX_TOKENS=1024
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
OPENAI_TIMEOUT_MS=20000
OPENAI_MAX_RETRIES=1
OPENAI_STT_TIMEOUT_MS=12000
OPENAI_TTS_TIMEOUT_MS=12000

# ── Provider: gemini ──────────────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TEMPERATURE=0.3
GEMINI_STT_MODEL=gemini-3.5-flash
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
GEMINI_TTS_VOICE=Charon
GEMINI_THINKING_BUDGET=0
GEMINI_MAX_TOKENS=1024
GEMINI_TTS_STREAM=false
VOICE_TTS_PREFER=gemini
VOICE_PORTAL_TTS_PREFER=openai

# ── Portal (latência de voz) ──────────────────────────────────────────────────
PORTAL_STT_PREFER=openai
PORTAL_MAX_TOKENS=300
PORTAL_GEMINI_THINKING_BUDGET=0
PORTAL_VOICE_MIN_FLUSH_CHARS=60
PORTAL_VOICE_STALL_FLUSH_MS=300
VOICE_TTS_CONCURRENCY=8
VOICE_DEV_MODE=false
USAGE_LIMIT_DISABLED=true
VOICE_EMBED_ANON=true

# ── Captura de voz (NEXT_PUBLIC_* entra no BUILD da imagem Jarvis) ────────────
NEXT_PUBLIC_VOICE_MIC_REARM_MS=350
NEXT_PUBLIC_VAD_POSITIVE_THRESHOLD=0.7
NEXT_PUBLIC_VAD_MIN_SPEECH_MS=250
NEXT_PUBLIC_VOICE_MIN_UTTERANCE_MS=600
NEXT_PUBLIC_VAD_REDEMPTION_MS=1600
NEXT_PUBLIC_SITE_URL=http://localhost

# ── Supabase (auth + RAG cloud; compose também sobe postgres local) ───────────
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── RAG ───────────────────────────────────────────────────────────────────────
RAG_ENABLED=true
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150
RAG_LEAN_INDEX=true
RAG_PORTAL_REPO=owner/repo
RAG_AGENTS_ROOT=
RAG_ADMIN_TOKEN=
GITHUB_TOKEN=
OLLAMA_EMBED_MODEL=nomic-embed-text
